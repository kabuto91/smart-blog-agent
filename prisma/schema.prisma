generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model SiteConfig {
  id     Int    @id @default(1)
  config String
  
  @@map("site_config")
}

model SiteStats {
  id            Int  @id @default(1)
  totalViews    Int  @default(0) @map("total_views")
  totalArticles Int  @default(0) @map("total_articles")
  totalLikes    Int  @default(0) @map("total_likes")

  @@map("site_stats")
}

model ThemeSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  messages  ThemeMessage[]

  @@map("theme_sessions")
}

model ThemeMessage {
  id             Int      @id @default(autoincrement())
  sessionId      String   @map("session_id")
  role           String
  content        String
  htmlSnapshot   String?  @map("html_snapshot")
  contentConfig  String?  @map("content_config")
  createdAt      DateTime @default(now()) @map("created_at")
  session        ThemeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("theme_messages")
}

model Theme {
  id            String   @id @default(uuid())
  name          String
  html          String
  contentConfig String?
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("themes")
}

model Upload {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  data      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("uploads")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("categories")
}

model Tag {
  id        String       @id @default(uuid())
  name      String       @unique
  slug      String       @unique
  articles  ArticleTag[]
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("tags")
}

model Article {
  id         String        @id @default(uuid())
  title      String
  slug       String        @unique
  content    String
  excerpt    String?
  published  Boolean       @default(false)
  categoryId String?       @map("category_id")
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       ArticleTag[]
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("articles")
}

model ArticleTag {
  articleId String  @map("article_id")
  tagId     String  @map("tag_id")
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

model LLMConfig {
  id        Int      @id @default(1)
  baseUrl   String   @default("") @map("base_url")
  model     String   @default("")
  apiKey    String   @default("") @map("api_key")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("llm_config")
}
