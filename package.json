{
  "name": "smart-blog-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI 驱动的博客 CMS（monorepo）：apps/web 前台（部署 Vercel）+ apps/admin 后台（本地运行）+ packages/core 共享库",
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "dev:admin": "pnpm --filter @smart-blog/admin dev",
    "dev:web": "pnpm --filter @smart-blog/web dev",
    "build:admin": "pnpm --filter @smart-blog/admin build",
    "build:web": "pnpm --filter @smart-blog/web build",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1"
  }
}
